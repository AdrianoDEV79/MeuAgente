# Chave do provedor compatível com a API da OpenAI.
OPENAI_API_KEY=sk-your-key-here

# Opcional: use um endpoint compatível, como DeepSeek.
# OPENAI_BASE_URL=https://api.deepseek.com

# Modelo usado pelo backend.
OPENAI_MODEL=gpt-4o-mini

# Configuração local do servidor.
PORT=3000
HOST=127.0.0.1

# Origens permitidas separadas por vírgula. Para uso local, mantenha localhost.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
