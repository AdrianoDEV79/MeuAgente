# Provedores disponíveis no seletor do VS Code.
# Separe vários IDs por vírgula: openai,deepseek,ollama
LLM_PROVIDERS=openai,deepseek

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Exemplo de outro servidor compatível com a API da OpenAI.
# O prefixo deve corresponder ao ID em LLM_PROVIDERS.
# OLLAMA_API_KEY=local-not-required-by-some-servers
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_NAME=Ollama local

# Configuração local do servidor.
PORT=3000
HOST=127.0.0.1

# Origens permitidas separadas por vírgula. Para uso local, mantenha localhost.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
